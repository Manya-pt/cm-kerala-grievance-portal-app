# ===== Backend (backend/.env) =====
# Copy to backend/.env for local development. NEVER commit the real .env file.

# Long random string used to sign login tokens (JWT)
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters

# PostgreSQL connection string (Supabase -> Connect -> Session pooler).
# Leave empty locally to use a SQLite file instead.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Frontend URL allowed to call the API (comma-separated). * allows all (local only).
FRONTEND_ORIGIN=http://localhost:5173

# Insert demo data automatically when the database is empty
SEED_ON_START=true
JWT_EXPIRY_HOURS=12

# ===== Frontend (frontend/.env) =====
# Backend URL. Leave empty locally (Vite proxies /api to localhost:5000).
VITE_API_URL=https://cmk-grievance-api.onrender.com
